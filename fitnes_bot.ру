@dp.message(Form.waiting_food)
async def food_save(message: types.Message, state: FSMContext):
    entry = {
        "date": datetime.now().strftime("%d.%m.%Y %H:%M"),
        "text": message.text
    }
    user_data.setdefault("food_log", []).append(entry)
