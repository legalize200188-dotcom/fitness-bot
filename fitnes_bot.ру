@dp.message(F.text == "📊 Мой прогресс")
async def progress(message: types.Message):
    weights = user_data.get("weight_log", [])
    workouts = user_data.get("workout_log", [])
    
    text = "<b>📊 Твой прогресс</b>\n\n"
    
    if weights:
        text += "<b>Вес:</b>\n"
        for entry in weights[-7:]:
            text += f"• {entry['date']}: {entry['weight']} кг\n"
        last = weights[-1]["weight"]
        start = PROFILE["weight"]
        diff = round(start - last, 1)
        text += f"\nИзменение с начала: {diff:+} кг\n"
    else:
        text += "Вес ещё не записывался.\nНапиши «вес 61.2» чтобы добавить.\n"
    
    text += f"\n<b>Тренировок записано:</b> {len(workouts)}\n"
    
    if workouts:
        text += "Последние:\n"
        for w in workouts[-5:]:
            text += f"• {w['date']}: {w['day']}\n"
    
    text += "\nЧтобы записать вес — напиши, например: <code>вес 60.8</code>"
    await message.answer(text, parse_mode="HTML", reply_markup=main_kb())

