@dp.message(F.text.regexp(r"(?i)вес\s+(\d+[.,]?\d*)"))
async def log_weight(message: types.Message):
    import re
    match = re.search(r"(\d+[.,]?\d*)", message.text)
    if match:
        weight = float(match.group(1).replace(",", "."))
        entry = {
            "date": datetime.now().strftime("%d.%m.%Y"),
            "weight": weight
        }
        user_data.setdefault("weight_log", []).append(entry)
        save_data(user_data)
        
        diff = round(PROFILE["weight"] - weight, 1)
        await message.answer(
            f"✅ Вес записан: <b>{weight} кг</b>\n"
            f"Изменение с исходного: {diff:+} кг\n\n"
            f"Так держать!",
            parse_mode="HTML",
            reply_markup=main_kb()
        )

